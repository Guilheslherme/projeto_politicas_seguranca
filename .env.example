DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Chave AES-256 que cifra dados em repouso, como o segredo do 2FA (requisito 3.6).
# 32 bytes em base64. Gere com:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ATENCAO: o ambiente local e o Render usam o mesmo banco, entao precisam da MESMA chave.
# Perder ou trocar esta chave torna ilegiveis os segredos ja cifrados.
FIELD_ENCRYPTION_KEY=

# Enderecos que a aplicacao aceita atender, separados por virgula.
# Em producao, o dominio do Render. O padrao do codigo cobre o uso local.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSL_CA=certs/aiven-ca.pem

# Envio de e-mail da recuperacao de senha - API do Brevo (requisito 2.1)
# Sem BREVO_API_KEY, o link e impresso na saida do servidor em vez de enviado.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Health In Sight

# Endereco publico usado para montar o link do e-mail.
# Em producao precisa ser o endereco https do Render.
APP_BASE_URL=http://localhost:8000
