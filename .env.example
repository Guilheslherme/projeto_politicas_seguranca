DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Enderecos que a aplicacao aceita atender, separados por virgula.
# Em producao, o dominio do Render. O padrao do codigo cobre o uso local.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSL_CA=certs/aiven-ca.pem

# Envio de e-mail da recuperacao de senha - API do Brevo (requisito 2.1)
# Sem BREVO_API_KEY, o link e impresso na saida do servidor em vez de enviado.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Health In Sight

# Endereco publico usado para montar o link do e-mail.
# Em producao precisa ser o endereco https do Render.
APP_BASE_URL=http://localhost:8000
